set -eu

if [ "$1" = remove ]; then
    for role in manager media agent proxy; do
        if [ -d /run/systemd/system ]; then
            systemctl stop "srk@$role.service" >/dev/null 2>&1 || :
        fi
        systemctl disable "srk@$role.service" >/dev/null 2>&1 || :
    done
fi
